# =============================================================
# Inexci API — Variáveis de Ambiente
#
# Este arquivo é para rodar a API NO HOST (`yarn start:dev`), com
# Postgres/Redis/STT no Docker (`docker-compose up -d db redis stt-service`).
# Se for subir TUDO pelo Docker, use o `.env.example` da raiz.
#
#   cp .env.example .env
#
# O arquivo está dividido em 4 blocos:
#   1. OBRIGATÓRIAS PARA SUBIR  — sem elas a API não inicia. Os valores
#      abaixo já funcionam em dev; só o R2 precisa de credencial real
#      para upload de arquivos funcionar.
#   2. RECURSOS OPCIONAIS       — e-mail, IA, WhatsApp, pagamento, captcha.
#      A API sobe sem elas; só o recurso correspondente fica desligado.
#   3. SÓ PRODUÇÃO              — deixe vazias em dev.
#   4. AJUSTES FINOS            — todas têm padrão; não precisa mexer.
#
# Produção usa `.env.production.example` (raiz). Nunca reutilize em produção
# os valores "dev-only" daqui: a API recusa subir com eles em NODE_ENV=production.
# =============================================================


# #############################################################
# 1. OBRIGATÓRIAS PARA SUBIR
# #############################################################

NODE_ENV=development
PORT=3002

# Postgres do docker-compose (usuário/senha padrão do compose de dev)
DATABASE_URL=postgresql://inexci_user:inexci_pass@localhost:5432/inexci

# Redis do docker-compose (a senha padrão do compose de dev é inexci_redis_dev)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=inexci_redis_dev

# Endereço do frontend (links em e-mails) e origens liberadas no CORS.
# localhost:3002 entra para o Swagger (/api/docs) conseguir chamar /auth.
DASHBOARD_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# JWT. Em produção: `openssl rand -base64 64`.
JWT_SECRET=dev-only-jwt-secret-troque-em-producao-000000000000
JWT_ISSUER=inexci-api
JWT_AUDIENCE=inexci-app

# Salt do hash de telefone (LGPD). Em produção: `openssl rand -hex 32`.
PHONE_HASH_SALT=dev-only-phone-salt-troque-em-producao-0000000000

# Cloudflare R2 (armazenamento de arquivos). A API sobe com os valores abaixo,
# mas upload/download de documentos só funciona com as credenciais do bucket
# de desenvolvimento (peça a quem administra a conta Cloudflare).
R2_ACCOUNT_ID=preencha-com-o-account-id
R2_ACCESS_KEY_ID=preencha-com-a-access-key
R2_SECRET_ACCESS_KEY=preencha-com-a-secret-key
R2_BUCKET=preencha-com-o-bucket-de-dev


# #############################################################
# 2. RECURSOS OPCIONAIS (a API sobe sem eles)
# #############################################################

# ---- E-mail (SMTP/Brevo) — sem isso, e-mails falham na fila e só geram log
MAIL_HOST=
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASS=
MAIL_FROM_NAME=Inexci
MAIL_FROM_ADDRESS=no-reply@inexci.com.br

# ---- OpenAI — assistente do WhatsApp, extração de documento e RAG
OPENAI_API_KEY=
# Modelo do assistente. Fallback estável: gpt-4o-mini.
OPENAI_MODEL=gpt-5-mini
# Não troque sem reindexar os chunks do RAG.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Twilio (WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Validação da assinatura do webhook. Em dev com ngrok a URL raramente bate:
# use false. Só é respeitado com NODE_ENV=development/test; fora disso sempre valida.
TWILIO_VALIDATE_SIGNATURE=false

# ---- Transcrição de áudio (stt-service do docker-compose)
# faster_whisper = serviço interno. Use 'openai' só com consentimento para envio
# de áudio clínico a terceiros.
AI_TRANSCRIPTION_PROVIDER=faster_whisper
AI_STT_FASTER_WHISPER_URL=http://localhost:8000

# ---- Stripe (assinaturas). Sem isso, o checkout não funciona.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs de cada plano (gravados por `yarn seed:prices`). Use IDs do mesmo
# modo (test/live) da STRIPE_SECRET_KEY.
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_ESSENCIAL_MONTHLY=
STRIPE_PRICE_ESSENCIAL_YEARLY=
STRIPE_PRICE_PROFISSIONAL_MONTHLY=
STRIPE_PRICE_PROFISSIONAL_YEARLY=
STRIPE_PRICE_AVANCADO_MONTHLY=
STRIPE_PRICE_AVANCADO_YEARLY=

# ---- Captcha do cadastro (Cloudflare Turnstile). Vazio = cadastro sem captcha.
# Se preencher, preencha também NEXT_PUBLIC_TURNSTILE_SITE_KEY no frontend.
TURNSTILE_SECRET_KEY=


# #############################################################
# 3. SÓ PRODUÇÃO (deixe vazias em dev)
# #############################################################

# Chave AES-256-GCM das colunas cifradas (notas clínicas, mensagens do WhatsApp).
# Obrigatória em produção: `openssl rand -hex 32`. Vazia em dev = texto puro.
DB_ENCRYPTION_KEY=

# Senha compartilhada entre API e stt-service (header X-STT-Token).
# Produção: `openssl rand -hex 32`. Vazia = stt-service aceita qualquer chamada.
AI_STT_SHARED_TOKEN=

# TLS até o Postgres — só quando o banco está em outra máquina.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL_CA=

# Redis gerenciado (com usuário/TLS)
REDIS_USERNAME=
REDIS_TLS=false

# Cookie de refresh: vazio = padrão seguro (SameSite=Lax, Path=/auth).
# Só preencha para sobrescrever.
AUTH_REFRESH_COOKIE_SAMESITE=
AUTH_REFRESH_COOKIE_SECURE=
AUTH_REFRESH_COOKIE_PATH=
AUTH_REFRESH_COOKIE_DOMAIN=

# Login do painel de filas /admin/queues (vazio = painel desligado)
BULL_BOARD_USER=
BULL_BOARD_PASS=

# Observabilidade (Grafana Cloud). Vazio = OpenTelemetry desligado.
# Em produção o compose aponta para o Alloy; aqui só para dev sem Alloy.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_METRICS_ENABLED=false
# Consumidas pelo serviço `alloy`, não pela API (ficam no .env da raiz).
GRAFANA_CLOUD_TOKEN=
GRAFANA_OTLP_ENDPOINT=
GRAFANA_OTLP_USER=
GRAFANA_LOKI_ENDPOINT=
GRAFANA_LOKI_USER=


# #############################################################
# 4. AJUSTES FINOS (todas têm padrão — não precisa mexer)
# #############################################################

DATABASE_POOL_MAX=10
OPENAI_REQUEST_TIMEOUT_MS=25000
STRIPE_REQUEST_TIMEOUT_MS=15000
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# ---- Conversa do assistente (WhatsApp)
AI_SESSION_TIMEOUT_MINUTES=60
# Mensagens completas por turno; o resumo é regenerado a cada N mensagens.
# Regra: trigger <= max/2.
AI_MAX_RECENT_MESSAGES=15
AI_SUMMARY_TRIGGER_EVERY_MESSAGES=5
AI_SUMMARY_MAX_TOKENS=550
AI_CONTEXT_TOKEN_BUDGET=4500
AI_RESPONSE_MAX_TOKENS=500
AI_PROCESS_TIMEOUT_MS=90000
CONVERSATION_CLEANUP_DAYS=15

# ---- Áudio
AI_AUDIO_ENABLED=true
AI_TRANSCRIPTION_TIMEOUT_MS=30000
AI_STT_ENABLE_FALLBACK=false
AI_STT_OPENAI_MODEL=gpt-4o-mini-transcribe
AI_STT_OPENAI_URL=https://api.openai.com/v1/audio/transcriptions
AI_AUDIO_ALLOWED_MIME=audio/ogg,audio/mpeg,audio/mp4,audio/webm,audio/wav,audio/x-wav
AI_AUDIO_MAX_BYTES=15728640
AI_AUDIO_MAX_DURATION_SECONDS=300
AI_AUDIO_DOWNLOAD_TIMEOUT_MS=15000
AI_AUDIO_DEBUG_PERSIST=false
AI_AUDIO_DEBUG_DIR=/tmp/inexci-audio-debug
# Ditado por voz na ficha de atendimento (POST /clinical-records/transcribe).
# Desligado até a qualidade da transcrição ser validada. Anda junto com
# NEXT_PUBLIC_CLINICAL_DICTATION_ENABLED do frontend.
CLINICAL_DICTATION_ENABLED=false
AI_AUDIO_DEBUG_RETENTION_HOURS=24

# ---- Documentos / OCR
AI_DOC_ENABLED=true
AI_DOC_MAX_BYTES=10485760
AI_DOC_ALLOWED_IMAGE_MIME=image/jpeg,image/jpg,image/png,image/webp
AI_DOC_ALLOWED_PDF_MIME=application/pdf
AI_DOC_MAX_PAGES=15
AI_DOC_OCR_PARALLEL_WORKERS=3
AI_DOC_PENDING_TTL_MINUTES=10
AI_DOC_TMP_FOLDER=whatsapp-tmp
AI_DOC_TMP_RETENTION_HOURS=1
AI_DOC_OCR_LANG=por
AI_DOC_CLASSIFIER_MODEL=gpt-5.4-nano
AI_DOC_CLASSIFIER_MAX_INPUT_CHARS=22000
AI_DOC_CLASSIFIER_MAX_TOKENS=4000
AI_DOC_CLASSIFIER_TIMEOUT_MS=60000
AI_DOC_SC_FROM_DOCUMENT_MAX_PAGES=15
AI_DOC_SC_EXTRACT_JOB_TTL_SECONDS=1200
AI_DOC_VISION_FALLBACK_ENABLED=true
AI_DOC_VISION_FALLBACK_MODEL=gpt-4.1
AI_DOC_VISION_FALLBACK_MAX_TOKENS=2500
AI_DOC_VISION_DETAIL=auto

# ---- Logs e retenção (dias)
LOG_LEVEL=log
# Vazio = automático (legível em dev, JSON em produção)
LOG_PRETTY=
SLOW_REQUEST_THRESHOLD_MS=1500
LOG_RETENTION_NOTIFICATION_DAYS=90
LOG_RETENTION_AI_USAGE_DAYS=365
LOG_RETENTION_PII_DAYS=180
LOG_RETENTION_STALE_DAYS=60
LOG_RETENTION_READ_NOTIFICATION_DAYS=90
LOG_RETENTION_CLINICAL_AUDIT_DAYS=1825

# ---- Outros
# Minutos até o e-mail de menção (@) sair, se a notificação seguir não lida.
MENTION_EMAIL_DELAY_MINUTES=10
